# =====================================================
# SHARED / MONOREPO
# Used by: Backend + Frontend
# =====================================================
NODE_ENV=development
BASE_URL=http://localhost
DOCKER_ENVIRONMENT=true
USE_HOST_DOCKER_INTERNAL=false

# =====================================================
# BACKEND APP (apps/backend)
# Core server + auth + database runtime
# =====================================================
PORT=10580
JWT_SECRET=your-jwt-secret

# Backend primary PostgreSQL
DATABASE_URL=postgresql://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dlsu_gate_system

# Backend source SQL Server sync
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=1433
SOURCE_DB_USERNAME=sa
SOURCE_DB_PASSWORD=your-source-db-password
SOURCE_DB_NAME=TransferData
SOURCE_DB_TABLE=isgate_test_view

# Backend campus mode selector
# - "dasma" keeps remarks-aware campus behavior.
# - any non-"dasma" value is treated as Main/Taft/Laguna path behavior.
SOURCE_DB_SCHEMA_ENV=dasma

# Backend BioStar integration
BIOSTAR_API_BASE_URL=https://127.0.0.1:4433
BIOSTAR_API_LOGIN_ID=admin
BIOSTAR_API_PASSWORD=your-biostar-password

# Backend sync/report tuning
POLLING_INTERVAL=1000
SYNC_BATCH_SIZE=800

# Local QA test-account seeding only (apps/backend/scripts/seed-qa-test-account.ts).
# Never set/use this in production.
QA_TEST_ACCOUNT_PASSWORD=

# =====================================================
# FRONTEND APP (apps/portal-web)
# Used by Next.js runtime/build (public client vars)
# =====================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_CAMPUS=DASMA
NEXT_PUBLIC_MOCK_MODE=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:10580
NEXT_PUBLIC_WS_HOST=wss://127.0.0.1:4439
NEXT_PUBLIC_BIOSTAR_API=https://127.0.0.1:4433
NEXT_PUBLIC_BIOSTAR_LOGIN_ID=admin
NEXT_PUBLIC_BIOSTAR_PASSWORD=your-public-biostar-password

# =====================================================
# REQUIRED PAIRING FOR CAMPUS STATUS BEHAVIOR
# =====================================================
# 1) DASMA deployment:
#    SOURCE_DB_SCHEMA_ENV=dasma
#    NEXT_PUBLIC_CAMPUS=DASMA
#
# 2) Main/Taft/Laguna deployment:
#    SOURCE_DB_SCHEMA_ENV=<not "dasma">
#    NEXT_PUBLIC_CAMPUS=MAIN (or TAFT or LAGUNA)
