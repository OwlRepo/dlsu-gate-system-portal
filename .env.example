# =====================================================
# SHARED / MONOREPO
# Used by: Backend + Frontend
# =====================================================
NODE_ENV=development
BASE_URL=http://localhost
DOCKER_ENVIRONMENT=true
USE_HOST_DOCKER_INTERNAL=false

# =====================================================
# BACKEND APP (apps/backend)
# Core server + auth + database runtime
# =====================================================
PORT=10580
JWT_SECRET=your-jwt-secret
# Local development only: set to true to let tokenless requests through the
# auth guard as a mock user. Ignored when NODE_ENV=production. Never set in prod.
DEV_AUTH_BYPASS=false
# /health thresholds (optional). Defaults: heap 512MB, RSS 1024MB, disk 95%.
# HEALTH_HEAP_MB=512
# HEALTH_RSS_MB=1024
# HEALTH_DISK_THRESHOLD=0.95

# Backend primary PostgreSQL
DATABASE_URL=postgresql://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dlsu_gate_system

# Backend source SQL Server sync
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=1433
SOURCE_DB_USERNAME=sa
SOURCE_DB_PASSWORD=your-source-db-password
SOURCE_DB_NAME=TransferData
SOURCE_DB_TABLE=isgate_test_view

# Backend campus mode selector
# - "dasma" keeps remarks-aware campus behavior.
# - any non-"dasma" value is treated as Main/Taft/Laguna path behavior.
SOURCE_DB_SCHEMA_ENV=dasma

# Backend BioStar integration
BIOSTAR_API_BASE_URL=https://127.0.0.1:4433
BIOSTAR_API_LOGIN_ID=admin
BIOSTAR_API_PASSWORD=your-biostar-password

# Pulls users FROM BioStar INTO PostgreSQL. This is the ONLY code that ever
# writes a student's Photo or Unique_ID (their card) into PostgreSQL, so with
# it off the gate dashboards fall back to the default avatar and no API can
# return a card. Leave it on; the literal "false" is the only way to disable.
ENABLE_BIOSTAR_SYNC=true

# How many per-user BioStar detail requests run at once during that pull.
BIOSTAR_DETAIL_CONCURRENCY=8

# Safety valve on the same pull: stop after this many candidate users in one
# run. 0 means no limit.
BIOSTAR_MAX_CANDIDATES_PER_RUN=0

# Which BioStar user group the pull lists. EMPTY MEANS EVERY GROUP, which is
# what you want: a person moved to another group in BioStar is still the same
# person, and pinning this to one group stops syncing them with no error
# anywhere to say so. Set a number only to deliberately narrow the pull.
BIOSTAR_LIST_GROUP_ID=

# A backstop, not the mechanism. The pull ALWAYS lists every BioStar user and
# compares each list row against what PostgreSQL holds, so a photo that
# appeared without BioStar moving that user's last_modified is caught on the
# very next run. This setting controls something narrower: how often the pull
# additionally re-reads the full detail of every candidate, which catches a
# change no list field exposes at all. Hours; 0 means every run.
BIOSTAR_FULL_SYNC_INTERVAL_HOURS=24

# The pull normally only fetches the detail of a listed user who has a photo
# or a card, so a large roster does not cost one request per person. That
# relies on BioStar's own photo_exists flag. Set this to "off" if that flag
# turns out to be wrong on your BioStar — every listed user is then fetched,
# which is correct but much slower.
BIOSTAR_CANDIDATE_FILTER=

# Backend sync/report tuning
POLLING_INTERVAL=1000
SYNC_BATCH_SIZE=800

# Backend cache/session store. Falls back to an in-memory map when Redis is
# unreachable, which is NOT shared across instances — see risk-register.md.
REDIS_HOST=localhost
REDIS_PORT=6379

# Local development only. DEV_AUTH_BYPASS lets unauthenticated requests through
# as DEV_DEFAULT_ROLE when NODE_ENV=development. Never set either in production.
DEV_AUTH_BYPASS=false
DEV_DEFAULT_ROLE=

# Shared secret for the health endpoint's authenticated probe. Leave blank to
# disable that probe.
HEALTH_TEST_KEY=

# Local QA test-account seeding only (apps/backend/scripts/seed-qa-test-account.ts).
# Never set/use this in production.
QA_TEST_ACCOUNT_PASSWORD=

# =====================================================
# FRONTEND APP (apps/portal-web)
# Used by Next.js runtime/build (public client vars)
# =====================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_CAMPUS=DASMA
NEXT_PUBLIC_MOCK_MODE=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:10580
NEXT_PUBLIC_WS_HOST=wss://127.0.0.1:4439
NEXT_PUBLIC_BIOSTAR_API=https://127.0.0.1:4433
NEXT_PUBLIC_BIOSTAR_LOGIN_ID=admin
NEXT_PUBLIC_BIOSTAR_PASSWORD=your-public-biostar-password

# Shows the "Run Biostar Sync" button in Settings, which pulls photos and cards
# from BioStar without running the roster half. "Run Full Sync" already does
# both phases, so this button is a manual re-run of the second one — and it is
# the only way to pull photos while the source database is unreachable.
#
# Three things about it:
#   - UNSET MEANS HIDDEN. The frontend matches the literal "true", unlike the
#     backend's ENABLE_BIOSTAR_SYNC, which defaults to ON when unset. Leaving
#     this blank hides the button while the pull itself keeps working.
#   - It is baked in at BUILD time, like every NEXT_PUBLIC_ value. Editing it
#     and restarting does nothing; the frontend has to be rebuilt
#     (deployment_docs_ws2022_prod\update-monorepo.bat).
#   - Keep it in step with ENABLE_BIOSTAR_SYNC. Nothing enforces that, so the
#     mismatches are a visible button whose work is skipped, or a hidden button
#     over a pull that is running.
NEXT_PUBLIC_ENABLE_BIOSTAR_SYNC=true

# =====================================================
# REQUIRED PAIRING FOR CAMPUS STATUS BEHAVIOR
# =====================================================
# 1) DASMA deployment:
#    SOURCE_DB_SCHEMA_ENV=dasma
#    NEXT_PUBLIC_CAMPUS=DASMA
#
# 2) Main/Taft/Laguna deployment:
#    SOURCE_DB_SCHEMA_ENV=<not "dasma">
#    NEXT_PUBLIC_CAMPUS=MAIN (or TAFT or LAGUNA)

# =====================================================
# BUILD AND LOCAL TOOLING (optional)
# None of these are needed to run the system. Listed so a value read somewhere
# in the repo is never a surprise.
# =====================================================
# Set to 1 to let the frontend build past ESLint and TypeScript errors
# (next.config.ts). The Windows deploy scripts set it themselves when invoked
# as `deploy-service.bat skip-lint`. Never set it permanently: it turns a build
# failure into a runtime one.
# SKIP_LINT_BUILD=

# Database used by the backend e2e suite and the photo soak, kept separate so a
# test run can never touch development data. Created once with:
#   createdb -h localhost -p 5433 -U postgres dlsu_gate_system_e2e
# E2E_DB_NAME=dlsu_gate_system_e2e

# Where the live scenario harness reaches the running backend
# (apps/backend/scripts/scenario/). Defaults to http://127.0.0.1:10580.
# APP_BASE_URL=

# Port for the standalone BioStar stand-in used in frontend development
# (apps/portal-web/scripts/fake-biostar-server.ts).
# FAKE_BIOSTAR_PORT=
